modules = ["nodejs-20"]
run = "npm run dev"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "vm"
build = ["npm", "run", "build"]
run = ["npm", "start"]

[[ports]]
localPort = 5173
externalPort = 80

[env]
# The dashboard binds to $PORT; Replit sets it. 5173 is only the local fallback.
STATE_DIR = "state"

[agent]
expertMode = true
