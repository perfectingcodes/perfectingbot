{
  "name": "perfectingbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-strip-types src/main.ts",
    "scanner": "node --env-file-if-exists=.env --experimental-strip-types src/index.ts",
    "serve": "node --experimental-strip-types src/serve.ts",
    "replay": "node --experimental-strip-types src/replay.ts",
    "doctor": "node --env-file-if-exists=.env --experimental-strip-types src/doctor.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.0"
  }
}
