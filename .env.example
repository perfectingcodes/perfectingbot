# fomoapi.io key (Growth tier or above for the wss://api.fomoapi.io/ws/trades on-chain stream)
FOMO_API_KEY=

# RPCs. Every public endpoint below is rate-limited in practice — swap all of them for
# dedicated providers before running hot. Verified failures are listed in the README.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
BASE_RPC_URL=https://mainnet.base.org
# Public Solana refuses getTokenLargestAccounts — use Helius / QuickNode / Triton.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Volume-led discovery: what keeps the scanner busy between smart-money trades ──
DISCOVERY=on
DISCOVERY_NETWORKS=robinhood,solana,base,bsc
DISCOVERY_BOARDS=trending,graduated
# Defaults below burn ~1,056 credits/day (~31,680/month) — fits Growth with headroom.
# Each evaluation costs ~3 credits, so halving the interval doubles the bill.
DISCOVERY_INTERVAL_SEC=900
DISCOVERY_PER_CYCLE=3
DISCOVERY_MIN_VOLUME=50000
DISCOVERY_REVISIT_MIN=20

# Hard ceiling. Discovery pauses when this is spent and resumes at UTC midnight;
# the smart-money stream is exempt and keeps whatever is left.
CREDIT_DAILY_BUDGET=1500

# Optional webhook for alerts (Discord/Slack-compatible JSON {content})
ALERT_WEBHOOK_URL=

# flag | paper  -- 'live' is intentionally not implemented, see src/exec/live.ts
MODE=paper

# Where the evaluation log lives. On Replit the filesystem is wiped on redeploy —
# point this at a mounted volume if you want history to survive.
STATE_DIR=state

# Dashboard port. Replit sets PORT itself; leave unset locally to use 5173.
# PORT=5173

# Social velocity (tier 3). Any endpoint returning a mention count works;
# {token} is substituted. Unset = tier 3 reads "unknown" and costs score.
# SOCIAL_API_URL=https://example.com/mentions/{token}
# SOCIAL_API_KEY=
# SOCIAL_MENTIONS_PATH=mentions
# SOCIAL_QUALITY_PATH=quality_mentions
