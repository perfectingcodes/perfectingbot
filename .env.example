# fomoapi.io key (Growth tier or above for the wss://api.fomoapi.io/ws/trades on-chain stream)
FOMO_API_KEY=

# RPCs. Public endpoints are rate-limited; swap for a dedicated provider before running hot.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Optional webhook for alerts (Discord/Slack-compatible JSON {content})
ALERT_WEBHOOK_URL=

# flag | paper  -- 'live' is intentionally not implemented, see src/exec/live.ts
MODE=paper

# Where the evaluation log lives. On Replit the filesystem is wiped on redeploy —
# point this at a mounted volume if you want history to survive.
STATE_DIR=state

# Dashboard port. Replit sets PORT itself; leave unset locally to use 5173.
# PORT=5173

# Social velocity (tier 3). Any endpoint returning a mention count works;
# {token} is substituted. Unset = tier 3 reads "unknown" and costs score.
# SOCIAL_API_URL=https://example.com/mentions/{token}
# SOCIAL_API_KEY=
# SOCIAL_MENTIONS_PATH=mentions
# SOCIAL_QUALITY_PATH=quality_mentions
